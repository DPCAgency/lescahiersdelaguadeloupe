# Supabase — public keys (safe for client-side)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase — server-only keys (NEVER expose to the client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=your-supabase-database-url

# Azure Document Intelligence — server-only (NEVER expose to the client)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Document analysis provider selection: mock | azure
DOCUMENT_ANALYSIS_PROVIDER=mock
